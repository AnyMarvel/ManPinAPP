<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_library"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <include layout="@layout/toolbar_edit_profile" />

    <!-- 作者微信卡片 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="16dp"
        android:background="@drawable/bg_person_card"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="24dp"
        android:paddingRight="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="添加作者微信"
            android:textColor="@color/colorBlack"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="微信号"
            android:textColor="@color/colorGray"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_wechat_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="maxianer01"
            android:textColor="@color/colorBlack"
            android:textIsSelectable="true"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- 在线状态提示 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="作者不是随时在线，添加后请耐心等待通过～"
            android:textColor="@color/colorGray"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_weixin01"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_wechat_btn"
            android:text="复制微信号并跳转微信"
            android:textColor="@color/colorWhite"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="跳转后请在微信「添加朋友」中粘贴微信号搜索"
            android:textColor="@color/colorGray"
            android:textSize="11sp" />

    </LinearLayout>

</LinearLayout>
